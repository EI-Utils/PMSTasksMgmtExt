{
  "manifest_version": 3,
  "name": "PMS Tasks Management",
  "version": "3.0",
  "description": "Manage PMS tasks from Jira issues.",
  "incognito": "split",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["tabs", "scripting", "storage", "sidePanel"],
  "optional_host_permissions": [
    "https://sap-pms.einfochips.com/*",
    "https://sap-pms.einfochips.com:50000/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "service-worker.js"
  },
  "side_panel": {
    "default_path": "popup.html"
  },
  "action": {
    "default_title": "PMS Tasks Management",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
